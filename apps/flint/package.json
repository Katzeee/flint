{
  "name": "@flint/gui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <27.0.0"
  },
  "workspaces": [
    "cairn/packages/*",
    "cairn/packages/hosts/*"
  ],
  "scripts": {
    "build": "npm run build:deps && vite build",
    "build:deps": "npm run build --workspace=@cairn/design-tokens && npm run build --workspace=@cairn/ui",
    "typecheck": "npm run build:deps && tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.css\" --allow-empty-input",
    "test": "npm run build && node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "electron@41.10.7": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@cairn/host-tauri": "file:./cairn/packages/hosts/tauri",
    "@cairn/ui": "file:./cairn/packages/ui",
    "@tauri-apps/api": "^2.12.2",
    "lucide-react": "^1.39.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@cairn/lint": "file:./cairn/packages/lint",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "electron": "41.10.7",
    "esbuild": "0.28.2",
    "eslint": "^10.4.1",
    "playwright-core": "1.62.1",
    "prettier": "3.9.9",
    "stylelint": "^17.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.0"
  }
}
